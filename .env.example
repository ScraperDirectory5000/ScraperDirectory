# Postgres
POSTGRES_USER=unnamedfiles
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=unnamedfiles
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://unnamedfiles:change-me-locally@localhost:5432/unnamedfiles

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenSearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=persons

# API
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_MINUTES=60

# Required by OpenSearch 2.12+ even with the security plugin disabled
OPENSEARCH_INITIAL_ADMIN_PASSWORD=change-me-to-a-strong-random-value
API_CORS_ORIGINS=http://localhost:3000,https://unnamedfiles.com,https://www.unnamedfiles.com

# PayPal (sandbox creds — get from developer.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# FEC OpenFEC API. DEMO_KEY is a real shared low-rate key; use a data.gov key in production.
FEC_API_KEY=DEMO_KEY

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
