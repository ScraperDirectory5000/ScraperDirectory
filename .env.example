# Postgres
POSTGRES_USER=peoplefinder
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=peoplefinder
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://peoplefinder:change-me-locally@localhost:5432/peoplefinder

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenSearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=persons

# API
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_MINUTES=60

# Required by OpenSearch 2.12+ even with the security plugin disabled
OPENSEARCH_INITIAL_ADMIN_PASSWORD=change-me-to-a-strong-random-value
API_CORS_ORIGINS=http://localhost:3000,https://scraper-directory.vercel.app

# PayPal (sandbox creds — get from developer.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
