# POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB — pick real, strong values for prod
POSTGRES_USER=unnamedfiles
POSTGRES_PASSWORD=change-me-to-a-strong-random-value
POSTGRES_DB=unnamedfiles

JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_MINUTES=60

# Required by OpenSearch 2.12+ even with the security plugin disabled
OPENSEARCH_INITIAL_ADMIN_PASSWORD=change-me-to-a-strong-random-value

# The Vercel-deployed frontend's URL(s), comma-separated
API_CORS_ORIGINS=https://unnamedfiles.com,https://www.unnamedfiles.com

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# FEC OpenFEC API. Replace DEMO_KEY with a free data.gov API key for higher rate limits.
FEC_API_KEY=DEMO_KEY

SEC_EDGAR_USER_AGENT=unnamedfiles-prod contact@unnamedfiles.com

# Allows paced current-news searches to finish before a fresh search response returns.
SCRAPER_WAIT_SECONDS=35

# GDELT currently throttles the Oracle production IP. Enable only after access is approved.
ENABLE_GDELT_NEWS=false
