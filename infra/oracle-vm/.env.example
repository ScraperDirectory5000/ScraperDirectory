# POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB — pick real, strong values for prod
POSTGRES_USER=peoplefinder
POSTGRES_PASSWORD=change-me-to-a-strong-random-value
POSTGRES_DB=peoplefinder

JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_MINUTES=60

# The Vercel-deployed frontend's URL(s), comma-separated
API_CORS_ORIGINS=https://scraper-directory.vercel.app

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

SEC_EDGAR_USER_AGENT=peoplefinder-prod you@yourdomain.com
