{
  "name": "@unnamedfiles/scrapers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/**/*.test.js",
    "start": "node dist/index.js",
    "bulk:ingest": "tsx src/bulk/cli.ts",
    "bulk:start": "node dist/bulk/worker.js",
    "enqueue": "tsx src/cli.ts"
  },
  "dependencies": {
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "undici": "^6.19.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
